# RackTag environment variables

# Required for auth (production)
AUTH_SECRET=generate-a-long-random-string

# Vercel Postgres (auto-injected on Vercel when database is linked)
POSTGRES_URL=

# One-time org bootstrap (optional)
SETUP_TOKEN=

# Stripe billing (Pro plan)
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Enterprise SSO (OIDC — Azure AD, Okta, etc.)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
